# Copy to .env (gitignored) and fill in the two passwords (trading-bots-db/.env).

# Where the page is served. Native run: any address. Docker: the binary
# listens on 0.0.0.0 inside the container and PLOTTER_BIND picks the host
# address the port is published on (loopback, or the VPN address).
PLOTTER_ADDR=127.0.0.1:8095
PLOTTER_BIND=127.0.0.1

# Postgres. Three ways to reach it:
#   native run, tunnel on this machine:        127.0.0.1:15432
#   docker, tunnel on this machine:            host.docker.internal:15432
#   docker with the tunnel sidecar (--profile tunnel):  tunnel:15432
DATABASE_URL=postgres://trading-bots:CHANGE_ME@127.0.0.1:15432/trading-bots-db
# The Access hostname the tunnel sidecar forwards (profile `tunnel`).
DB_TUNNEL_HOSTNAME=db.lz-co.xyz

# ClickHouse over HTTP(S): by hostname when this machine may reach it, or
# through the local forward from `just tunnels` (http://127.0.0.1:18123 native,
# http://host.docker.internal:18123 from docker).
CLICKHOUSE_URL=https://chdb.lz-co.xyz
CLICKHOUSE_USER=trading-bots
CLICKHOUSE_PASSWORD=CHANGE_ME
CLICKHOUSE_DB=trading_bots

RUST_LOG=info
