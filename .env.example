# Where the plotter listens. Loopback: open http://127.0.0.1:8095 in a browser.
PLOTTER_ADDR=127.0.0.1:8095

# Postgres of trading-bots (orders, fills, events). From a laptop: run
# `just tunnels` in trading-bots-host-setup/cloudflare, which forwards
# db.<domain> to 127.0.0.1:15432. Credentials from trading-bots-db/.env.
DATABASE_URL=postgres://trading-bots:<postgres-password>@127.0.0.1:15432/trading-bots-db

# ClickHouse (quotes), the HTTP interface. Through the tunnel:
#   CLICKHOUSE_URL=http://127.0.0.1:18123    (just tunnels forwards chhttp.<domain>)
# or, from a machine whose address is on the Access bypass list:
#   CLICKHOUSE_URL=https://chdb.<domain>
CLICKHOUSE_URL=http://127.0.0.1:18123
CLICKHOUSE_USER=trading-bots
CLICKHOUSE_PASSWORD=<clickhouse-password>
CLICKHOUSE_DB=trading_bots

RUST_LOG=info
